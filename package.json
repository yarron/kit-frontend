{
	"name": "kit-frontend",
	"version": "1.0.0",
	"private": true,
	"description": "Next.js frontend for NestJS starter kit",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@9.1.3",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "next dev --port 3800",
		"build": "next build",
		"start": "next start --port 3800",
		"check": "biome check --write ./src ./e2e",
		"format": "biome format --write ./src ./e2e",
		"lint": "biome lint ./src ./e2e",
		"typecheck": "tsc --noEmit",
		"codegen": "graphql-codegen",
		"codegen:check": "graphql-codegen && git diff --exit-code --stat src/generated",
		"e2e": "E2E_SLOWMO=120 playwright test --headed",
		"e2e:headless": "playwright test",
		"e2e:report": "playwright show-report"
	},
	"dependencies": {
		"@apollo/client": "^4.1.4",
		"@base-ui/react": "^1.1.0",
		"@graphql-typed-document-node/core": "^3.2.0",
		"graphql": "^16.12.0",
		"next": "16.1.6",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"server-only": "^0.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@graphql-codegen/cli": "^6.1.1",
		"@graphql-codegen/client-preset": "^5.2.2",
		"@playwright/test": "^1.62.1",
		"@types/node": "^24.13.3",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"only-allow": "^1.2.2",
		"typescript": "^5.9.3"
	}
}
