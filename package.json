{
	"name": "nestjs-starter-kit-frontend",
	"version": "1.0.0",
	"private": true,
	"description": "Next.js \u0444\u0440\u043e\u043d\u0442 \u043a \u0441\u0442\u0430\u0440\u0442\u0435\u0440\u0443: Apollo \u0447\u0435\u0440\u0435\u0437 BFF-\u043f\u0440\u043e\u043a\u0441\u0438, \u0431\u044d\u043a\u0435\u043d\u0434 \u043d\u0430\u0440\u0443\u0436\u0443 \u043d\u0435 \u0432\u044b\u0441\u0442\u0430\u0432\u043b\u0435\u043d",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@9.1.3",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "next dev --port 3800",
		"build": "next build",
		"start": "next start --port 3800",
		"check": "biome check --write ./src",
		"format": "biome format --write ./src",
		"lint": "biome lint ./src",
		"typecheck": "tsc --noEmit",
		"codegen": "graphql-codegen"
	},
	"dependencies": {
		"@apollo/client": "^4.1.4",
		"@base-ui/react": "^1.1.0",
		"graphql": "^16.12.0",
		"next": "16.1.6",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"server-only": "^0.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@graphql-codegen/cli": "^6.1.1",
		"@graphql-codegen/client-preset": "^5.2.2",
		"@types/node": "^22.19.3",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"only-allow": "^1.2.2",
		"typescript": "^5.9.3"
	}
}
