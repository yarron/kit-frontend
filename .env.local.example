# Адрес бэкенда. В проде — ВНУТРЕННИЙ адрес приватной сети Railway,
# наружу бэкенд не выставляется вовсе.
BACKEND_GRAPHQL_URL=http://localhost:9800/gql

# Общий секрет между фронтом и бэком. Второй рубеж поверх приватной сети:
# даже внутри неё запрос без него не принимается.
BACKEND_SERVICE_TOKEN=dev-service-token

# Ключ админского доступа бэкенда (стартер использует x-api-key).
# В настоящем проекте здесь будет короткоживущий identity-JWT.
BACKEND_API_KEY=local-admin-key

# Заглушка идентичности до подключения Auth.js: подставляется в X-User-Id,
# когда сессии нет. Только для локальной разработки.
DEV_USER_ID=
